# PostgreSQL connection string for local runs. Keep the expected identity below in sync.
DATABASE_URL=postgresql://anketka:anketka_local_dev@127.0.0.1:55432/anketka_monitor
ANKETKA_EXPECTED_DB_NAME=anketka_monitor
ANKETKA_EXPECTED_DB_USER=anketka
ANKETKA_EXPECTED_DB_HOST=127.0.0.1
ANKETKA_EXPECTED_DB_PORT=55432
# Analytics provider-neutral endpoint. Keep the key outside Git.
ANALYTICS_ENABLED=false
ANALYTICS_DRY_RUN=false
ANALYTICS_PROVIDER=
ANALYTICS_ENDPOINT=
ANALYTICS_API_KEY=
ANALYTICS_MODEL=
ANALYTICS_PROMPT_VERSION=v4
# Optional transport settings.
ANALYTICS_TIMEOUT=30
ANALYTICS_ATTEMPTS=3
# Bot token from @BotFather.
TELEGRAM_TOKEN=
# Comma-separated Telegram chat IDs allowed to receive FAQ admin reports.
FAQ_ADMIN_CHAT_IDS=
# Public HTTPS URL of the web feed, used for the Telegram Mini App button.
MINI_APP_URL=
